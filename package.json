{
  "name": "bot-my-meals",
  "version": "0.1.0",
  "private": true,
  "description": "Bot My Meals \u2014 dual-approve household dinner PWA (vote \u2192 lock \u2192 recipes + shopping list)",
  "scripts": {
    "dev": "next dev -p 43147 -H 0.0.0.0",
    "prebuild": "node scripts/write-pwa-icons.mjs",
    "build": "next build",
    "start": "next start -p 43147 -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run && node --test scripts/check-pr-proof.test.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && node scripts/cf-deploy.mjs",
    "deploy:preview": "wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:sql": "node --test scripts/sql-tests/*.test.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.118.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.60.0",
    "next": "16.4.2",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.22.1",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "^4.151.2"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
