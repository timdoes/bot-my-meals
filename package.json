{
  "name": "bot-my-meals",
  "version": "0.1.0",
  "private": true,
  "description": "Bot My Meals — dual-approve household dinner PWA (vote → lock → recipes + shopping list)",
  "scripts": {
    "dev": "next dev -p 43147 -H 0.0.0.0",
    "prebuild": "node scripts/write-pwa-icons.mjs",
    "build": "next build",
    "start": "next start -p 43147 -H 0.0.0.0",
    "lint": "eslint",
    "lint:comments": "node scripts/lint-comments.mjs",
    "test": "vitest run && node --test scripts/check-pr-proof.test.mjs scripts/eslint-comments-plugin.test.mjs scripts/lint-comments.test.mjs",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "build:worker": "opennextjs-cloudflare build",
    "deploy": "opennextjs-cloudflare build && node scripts/cf-deploy.mjs",
    "deploy:preview": "wrangler versions upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "test:sql": "node --test scripts/sql-tests/*.test.mjs",
    "test:sql:race": "node --test scripts/sql-tests/race/*.test.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.17",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.74.0",
    "next": "16.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shadcn": "^4.23.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.16",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^10",
    "eslint-config-next": "16.4.6",
    "pg": "^8.23.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.164.0"
  },
  "overrides": {
    "@node-minify/core": {
      "glob": "10.5.0"
    }
  }
}
