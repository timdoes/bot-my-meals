{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Household PWA. Worker name stays `bot-my-meals`. Do not rename.
  //
  // DIY: attach YOUR workers.dev URL or YOUR custom domain in the Cloudflare
  // dashboard. Do not uncomment `routes` here — `wrangler deploy` with
  // custom_domain: true creates DNS. Runbook: docs/domains.md
  //
  // "routes": [
  //   { "pattern": "meals.example.com", "custom_domain": true }
  // ]
  //
  // Do not use {handle}.botmymeals.com — that is not a DIY hostname.
  "name": "bot-my-meals",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  // Optional Worker secrets (dashboard or `wrangler secret put`). Never NEXT_PUBLIC_.
  // BOT_WAKE_WEBHOOK_URL and BOT_WAKE_WEBHOOK_KEY wake the household Grok Bot.
  // CLOUDFLARE_ACCOUNT_ID and CLOUDFLARE_API_TOKEN let Settings → Wake your Bot save those two.
  "preview_urls": true,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Daily keep-awake ping (Supabase Free pauses after 7 idle days). 12:27 UTC.
  // One anon peek_join_token read using the install's public vars; see src/lib/keep-awake.ts.
  "triggers": {
    "crons": ["27 12 * * *"]
  },
  "observability": {
    "enabled": true
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "bot-my-meals"
    }
  ]
}
